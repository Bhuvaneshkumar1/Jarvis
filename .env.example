# J.A.R.V.I.S. AI OS - Centralized Environment Configuration Template (Batch 8)
# DO NOT ADD ACTUAL SECRETS HERE. Copy to .env for local credentials.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
JARVIS_ENV=development
JARVIS_APP_NAME=JARVIS
JARVIS_APP_VERSION=0.1.0
JARVIS_DEBUG=false

# ------------------------------------------------------------------------------
# 2. RUNTIME LIFECYCLE & NETWORK
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
JARVIS_STARTUP_TIMEOUT=10.0
JARVIS_SHUTDOWN_TIMEOUT=10.0
JARVIS_COMPONENT_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# 3. LOGGING SUBSYSTEM
# ------------------------------------------------------------------------------
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_DIR=logs
JARVIS_LOG_RETENTION_DAYS=30
JARVIS_CONSOLE_LOGGING=true
JARVIS_FILE_LOGGING=true

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (Task Manager SQLite)
# ------------------------------------------------------------------------------
JARVIS_DATABASE_PATH=data/jarvis_tasks.db
JARVIS_DATABASE_TIMEOUT=30.0
JARVIS_DATABASE_WAL_MODE=true

# ------------------------------------------------------------------------------
# 5. SECURITY & POLICY GOVERNANCE
# ------------------------------------------------------------------------------
JARVIS_SECURITY_STRICT_MODE=true
JARVIS_ALLOW_AUTO_CREATE=true
JARVIS_REQUIRE_APPROVAL_FOR_MODIFY=true
JARVIS_REQUIRE_APPROVAL_FOR_DELETE=true
JARVIS_REQUIRE_APPROVAL_FOR_GIT_PUSH=true
JARVIS_REQUIRE_APPROVAL_FOR_FINANCIAL=true
PIN_REQUIRED=false
MAX_AUTH_ATTEMPTS=3
LOCKOUT_DURATION=300

# ------------------------------------------------------------------------------
# 6. TASK MANAGER LIMITS & DEFAULTS
# ------------------------------------------------------------------------------
JARVIS_TASK_MAX_TITLE_LENGTH=256
JARVIS_TASK_MAX_DESC_LENGTH=4096
JARVIS_TASK_MAX_META_KB=64
JARVIS_TASK_DEFAULT_PRIORITY=MEDIUM

# ------------------------------------------------------------------------------
# 7. INTERNAL EVENT BUS INFRASTRUCTURE
# ------------------------------------------------------------------------------
JARVIS_EVENT_QUEUE_SIZE=1000
JARVIS_EVENT_HISTORY_SIZE=500
JARVIS_EVENT_HANDLER_TIMEOUT=5.0
JARVIS_EVENT_MAX_RETRIES=3
JARVIS_EVENT_RETRY_DELAY=0.5

# ------------------------------------------------------------------------------
# 8. CORE ORCHESTRATOR OPERATIONAL BOUNDS
# ------------------------------------------------------------------------------
JARVIS_ORCHESTRATOR_OPERATION_TIMEOUT=30.0
JARVIS_ORCHESTRATOR_MAX_CONCURRENT=100

# ------------------------------------------------------------------------------
# 9. HARDWARE & RESOURCE TARGETS
# ------------------------------------------------------------------------------
JARVIS_MAX_MEMORY_GB=8
JARVIS_IDLE_MEMORY_TARGET_GB=3
JARVIS_MAX_MEMORY_MB=8192
JARVIS_IDLE_MEMORY_TARGET_MB=3072

# ------------------------------------------------------------------------------
# 10. FUTURE INTEGRATION CREDENTIAL METADATA (Reserved placeholders, no active code)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
