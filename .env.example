# JARVIS Environment Configuration Template
# DO NOT ADD ACTUAL SECRETS HERE. Copy to .env for local credentials.

# System Settings
JARVIS_ENV=development
JARVIS_LOG_DIR=logs
JARVIS_MAX_MEMORY_MB=8192
JARVIS_IDLE_MEMORY_TARGET_MB=3072

# Security & Policy
JARVIS_SECURITY_STRICT_MODE=true
JARVIS_ALLOW_AUTO_CREATE=true
JARVIS_REQUIRE_APPROVAL_FOR_MODIFY=true
JARVIS_REQUIRE_APPROVAL_FOR_DELETE=true
JARVIS_REQUIRE_APPROVAL_FOR_GIT_PUSH=true
JARVIS_REQUIRE_APPROVAL_FOR_FINANCIAL=true

# Privacy & Redaction Pattern Definitions
JARVIS_REDACT_KEYS=API_KEY,SECRET,PASSWORD,TOKEN,AUTH_BEARER,PRIVATE_KEY

# Integration Endpoints & Adapters (Configurations)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

OBSIDIAN_VAULT_PATH=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_URL=http://localhost:11434
