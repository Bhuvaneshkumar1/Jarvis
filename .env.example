# J.A.R.V.I.S. AI OS - Environment Configuration Template
# DO NOT ADD ACTUAL SECRETS HERE. Copy to .env for local credentials.

# SYSTEM NETWORK & LOGGING CONFIG
JARVIS_ENV=development
JARVIS_LOG_DIR=logs
JARVIS_MAX_MEMORY_MB=8192
JARVIS_IDLE_MEMORY_TARGET_MB=3072
HOST=127.0.0.1
PORT=5000

# SECURITY & POLICY TOGGLES
JARVIS_SECURITY_STRICT_MODE=true
JARVIS_ALLOW_AUTO_CREATE=true
JARVIS_REQUIRE_APPROVAL_FOR_MODIFY=true
JARVIS_REQUIRE_APPROVAL_FOR_DELETE=true
JARVIS_REQUIRE_APPROVAL_FOR_GIT_PUSH=true
JARVIS_REQUIRE_APPROVAL_FOR_FINANCIAL=true

# OPENROUTER AI CREDENTIALS
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_KEY=
OPENROUTER_KEY_3=
OPENROUTER_KEY_4=
OPENROUTER_KEY_5=
GROK_API_KEY=

# TELEGRAM BOT CREDENTIALS
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ELEVENLABS TTS CREDENTIALS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# GITHUB CREDENTIALS
GITHUB_TOKEN=
GITHUB_FINE_GRAINED_TOKEN=

# CLOUDFLARE CREDENTIALS
CLOUDFLARE_API_TOKEN=

# VIRUSTOTAL CREDENTIALS
