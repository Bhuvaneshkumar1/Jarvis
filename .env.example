# GOOGLE SUITE CREDENTIALS
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json

# OBSIDIAN INTEGRATION
OBSIDIAN_VAULT_PATH=

# YOUTUBE CREDENTIALS
YOUTUBE_API_KEY=

# QDRANT VECTOR DB CREDENTIALS
